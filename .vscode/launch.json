{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quartz: serve",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run serve",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Quartz: sync",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run sync",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Quartz: clean",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run clean",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Quartz: create",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run create",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Publish notes",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\publish-quartz.ps1",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Convert PJs",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\convert-all-characters.ps1 -VaultDirectory \"F:\\Vaults\\Knight\"",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Convert PNJs",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\convert-all-pnj.ps1 -VaultDirectory \"F:\\Vaults\\Knight\"",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Export effects",
      "type": "node-terminal",
      "request": "launch",
      "command": "powershell -ExecutionPolicy Bypass -File .\\scripts\\export-effects.ps1 -VaultDirectory \"F:\\Vaults\\Knight\"",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
