  "name": "Knight Adversaire Officiel",
  "id": "a8f3c7d1e542",
  "diceParsing": [
    {
      "regex": "\\{\\{aspect:(\\d+):(\\d+)\\}\\}",
      "parser": "const values = [...original.matchAll(/\\d+/g)].map((match) => Number(match[0]));\nconst score = values[0] || 0;\nconst exceptional = values[1] || 0;\n\nreturn {\n  text: `${score}d[0,0,0,1,1,1]${exceptional ? `+${exceptional}` : \"\"}|avg`,\n  original: String(score)\n};",
      "id": "knight-d6-aspect-successes",
      "desc": "Aspects uniquement : un D6 pair vaut 1 réussite, un D6 impair vaut 0 ; l'AE ajoute des réussites automatiques"
    },
    {
      "regex": "\\b\\d+[dD]6(?:\\s*(?:\\+|-|−)\\s*\\d+)?\\b(?!\\s*=)",
      "parser": "const dice = original\n  .replace(/[dD]/g, \"d\")\n  .replace(/−/g, \"-\")\n  .replace(/\\s+/g, \"\");\n\nreturn {\n  text: `${dice}|avg`,\n  original: original\n};",
      "id": "knight-d6-damage",
      "desc": "Dégâts, violence et initiative : moyenne initiale, puis jet au clic"
    }
  ]
