views:
  - type: cards
    name: Tableau
    filters:
      and:
        - type == "pnj"
        - visibility == "public"
    groupBy:
      property: subtype
      direction: ASC
    order:
      - file.name
      - faction
      - statut
    columnSize:
      portrait: 258
    image: portrait
    imageAspectRatio: 1
    cardSize: 240
    imageFit: cover
