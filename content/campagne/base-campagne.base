views:
  - type: cards
    name: Campagne
    filters:
      and:
        - type == "mission"
        - status.containsAny("done", "in progress")
        - visibility == "public"
        - file.path.contains("campagne")
    order:
      - name
      - code
    sort:
      - property: code
        direction: ASC
    image: note.image
